#!/usr/bin/env bash
# Install or update the public AI Orchestrator configuration.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

OC="$HOME/.config/opencode"
PLUGIN_MANIFEST="${PLUGIN_MANIFEST:-$REPO/config/plugin-dependencies.json}"
PRESERVE_LIVE=(--exclude node_modules --exclude package-lock.json --exclude bun.lock)
STAGE_EXCLUDES=("${PRESERVE_LIVE[@]}" --exclude package.json --exclude AGENTS.md)
ENGRAM_BIN="${ENGRAM_BIN:-engram}"
PLUGIN_VALIDATOR="${PLUGIN_VALIDATOR:-$REPO/bin/lib/verify-engram-plugin.mjs}"
PROMPT_VALIDATOR="${PROMPT_VALIDATOR:-$REPO/bin/lib/verify-agent-prompts.mjs}"
AGENTS_SOURCE="${AGENTS_SOURCE:-$REPO/config/AGENTS.md}"
POST_DEPLOY_VALIDATOR="${POST_DEPLOY_VALIDATOR:-}"

# Replace repository-managed blocks while preserving user-owned persona,
# overrides, and freeform text. The obsolete evidence-first block is removed.
splice_agents_md() {
  local src="$1" dst="$2" tmp

  python3 - "$src" "$dst" <<'PY'
import sys
from pathlib import Path

managed = ("pr-assignment-gate", "engram-protocol", "codegraph-guidance")
obsolete = ("evidence-first-delegation",)

def validate(path, require_managed):
    source = Path(path).read_text()
    lines = source.splitlines()
    intervals = []
    for name in managed + obsolete:
        opening = f"<!-- ai-orchestrator:{name} -->"
        closing = f"<!-- /ai-orchestrator:{name} -->"
        open_at = [index for index, line in enumerate(lines) if line == opening]
        close_at = [index for index, line in enumerate(lines) if line == closing]
        mentions = [line for line in lines if f"ai-orchestrator:{name}" in line]
        if len(mentions) != len(open_at) + len(close_at):
            raise ValueError(f"malformed {name} marker")
        required = require_managed and name in managed
        if not open_at and not close_at and not required:
            continue
        if len(open_at) != 1 or len(close_at) != 1:
            raise ValueError(f"{name} markers must contain exactly one opening and closing marker")
        if open_at[0] >= close_at[0]:
            raise ValueError(f"{name} markers are misordered")
        intervals.append((open_at[0], close_at[0], name))
    intervals.sort()
    for previous, current in zip(intervals, intervals[1:]):
        if current[0] <= previous[1]:
            raise ValueError(f"{current[2]} marker overlaps {previous[2]}")

try:
    validate(sys.argv[1], True)
    if Path(sys.argv[2]).is_file():
        validate(sys.argv[2], False)
except (OSError, ValueError) as error:
    print(f"ERROR: refusing to merge malformed AGENTS.md: {error}", file=sys.stderr)
    raise SystemExit(1)
PY

  if [ ! -f "$dst" ]; then
    cp "$src" "$dst"
    return 0
  fi

  tmp="$(mktemp "$(dirname "$dst")/.AGENTS.md.XXXXXX")"
  awk -v managedlist="pr-assignment-gate engram-protocol codegraph-guidance" \
      -v obsoletelist="evidence-first-delegation" '
    BEGIN {
      nmanaged = split(managedlist, M, " ")
      nobsolete = split(obsoletelist, O, " ")
      for (i = 1; i <= nmanaged; i++) {
        name = M[i]
        order[i] = name
        open_marker[name] = "<!-- ai-orchestrator:" name " -->"
        close_marker[name] = "<!-- /ai-orchestrator:" name " -->"
      }
      for (i = 1; i <= nobsolete; i++) {
        name = O[i]
        obsolete_open[name] = "<!-- ai-orchestrator:" name " -->"
        obsolete_close[name] = "<!-- /ai-orchestrator:" name " -->"
      }
    }
    FNR == NR {
      if (capturing) {
        src_block[current] = src_block[current] ORS $0
        if ($0 == close_marker[current]) {
          capturing = 0
          src_present[current] = 1
        }
        next
      }
      for (i = 1; i <= nmanaged; i++) {
        name = order[i]
        if ($0 == open_marker[name]) {
          current = name
          capturing = 1
          src_block[name] = $0
          next
        }
      }
      next
    }
    {
      if (skipping) {
        if ($0 == skip_close) skipping = 0
        next
      }
      for (i = 1; i <= nmanaged; i++) {
        name = order[i]
        if ($0 == open_marker[name]) {
          live_seen[name] = 1
          if (src_present[name]) printf "%s\n", src_block[name]
          skipping = 1
          skip_close = close_marker[name]
          next
        }
      }
      for (i = 1; i <= nobsolete; i++) {
        name = O[i]
        if ($0 == obsolete_open[name]) {
          skipping = 1
          skip_close = obsolete_close[name]
          next
        }
      }
      print
    }
    END {
      for (i = 1; i <= nmanaged; i++) {
        name = order[i]
        if (src_present[name] && !live_seen[name]) printf "\n%s\n", src_block[name]
      }
    }
  ' "$src" "$dst" > "$tmp"
  mv "$tmp" "$dst"
}

# Validate the optional managed plugin dependency manifest. Exit 0 when valid,
# 2 when absent, 1 when invalid.
validate_plugin_manifest() {
  [ -e "$1" ] || [ -L "$1" ] || return 2
  python3 - "$1" <<'PY'
import json
import sys

path = sys.argv[1]
try:
    with open(path) as handle:
        data = json.load(handle)
    deps = data.get("dependencies") if isinstance(data, dict) else None
    if not (
        data.get("private") is True
        and data.get("type") == "module"
        and isinstance(deps, dict)
        and all(
            isinstance(name, str) and name and isinstance(spec, str) and spec
            for name, spec in deps.items()
        )
    ):
        raise ValueError("unexpected manifest shape")
except (OSError, ValueError, AttributeError) as error:
    print(f"ERROR: invalid managed plugin dependency manifest {path}: {error}", file=sys.stderr)
    raise SystemExit(1)
PY
}

echo "== ai-orchestrator-setup bootstrap =="

# Build and validate the complete candidate, including the merged AGENTS.md,
# before installation, updates, backups, or active-config writes.
STAGE="$(mktemp -d "${TMPDIR:-/tmp}/ai-orchestrator-bootstrap.XXXXXX")"
trap 'rm -rf "$STAGE"' EXIT
rsync -a --delete "${STAGE_EXCLUDES[@]}" "$REPO/config/" "$STAGE/"
if [ -f "$OC/AGENTS.md" ]; then
  cp "$OC/AGENTS.md" "$STAGE/AGENTS.md"
fi
DEPLOY_EXCLUDES=("${PRESERVE_LIVE[@]}")
manifest_status=0
validate_plugin_manifest "$PLUGIN_MANIFEST" || manifest_status=$?
case "$manifest_status" in
  0)
    if [ -d "$OC/package.json" ]; then
      echo "ERROR: refusing to replace directory $OC/package.json" >&2
      exit 1
    fi
    echo "-> Staging managed plugin dependency manifest as package.json..."
    cp "$PLUGIN_MANIFEST" "$STAGE/.package.json.tmp"
    mv -f "$STAGE/.package.json.tmp" "$STAGE/package.json"
    ;;
  2)
    DEPLOY_EXCLUDES+=(--exclude package.json)
    ;;
  *)
    exit 1
    ;;
esac
echo "-> Merging AGENTS.md managed regions into staged candidate (preserving user regions)..."
splice_agents_md "$AGENTS_SOURCE" "$STAGE/AGENTS.md"

echo "-> Validating staged candidate..."
node -e 'const config = require(process.argv[1]); if (config.compaction?.auto !== true || config.compaction?.prune !== false) process.exit(1)' "$STAGE/opencode.json"
node "$PLUGIN_VALIDATOR" "$STAGE/plugins/engram.ts"
node "$PROMPT_VALIDATOR" "$STAGE"

# Keep the pinned Engram release current unless a test/user override supplies
# an explicit binary. The installer never removes ~/.engram data.
if [ "$ENGRAM_BIN" = "engram" ]; then
  "$REPO/bin/install-engram"
else
  echo "-> Using ENGRAM_BIN override: $ENGRAM_BIN"
fi

echo "-> Checking Engram atomic topic CAS capability..."
CAPABILITIES_JSON="$("$ENGRAM_BIN" capabilities --json 2>/dev/null)" || CAPABILITIES_JSON=""
if ! CAPABILITIES_JSON="$CAPABILITIES_JSON" python3 <<'PY'
import json
import os
import sys

try:
    capabilities = json.loads(os.environ["CAPABILITIES_JSON"])
    if capabilities.get("schema_version") != 1:
        raise RuntimeError("schema_version must be 1")
    feature = capabilities["features"]["atomic_topic_cas"]
    if feature.get("supported") is not True:
        raise RuntimeError("features.atomic_topic_cas.supported must be true")
    expected_revision = feature["input"]["expected_revision"]
    expected_input = {"type": "integer", "minimum": 0, "requires": "topic_key"}
    if expected_revision != expected_input:
        raise RuntimeError(f"expected_revision must declare exactly {expected_input}")
    contracts = {
        "success_fields": {"id", "sync_id", "revision_count"},
        "error_codes": {
            "revision_conflict",
            "expected_revision_requires_topic",
            "invalid_expected_revision",
        },
    }
    for field, expected in contracts.items():
        declared = feature.get(field)
        if not isinstance(declared, list) or len(declared) != len(expected) or set(declared) != expected:
            raise RuntimeError(f"features.atomic_topic_cas.{field} must declare exactly {sorted(expected)}")
except Exception as error:
    print(f"Engram capability preflight failed: {error}", file=sys.stderr)
    sys.exit(1)
PY
then
  echo "ERROR: bootstrap requires the Engram atomic_topic_cas capability contract (schema version 1)." >&2
  echo "       The active OpenCode config was not changed; existing backups remain intact." >&2
  exit 1
fi

if ! command -v codegraph >/dev/null 2>&1; then
  echo "-> Installing codegraph..."
  npm install -g @colbymchenry/codegraph
else
  echo "-> codegraph already installed"
fi

if command -v opencode >/dev/null 2>&1; then
  OPENCODE_BIN="$(command -v opencode)"
  if command -v brew >/dev/null 2>&1 && brew list --formula opencode >/dev/null 2>&1; then
    FORMULA_PREFIX="$(brew --prefix opencode 2>/dev/null || true)"
    RESOLVED_PATHS="$(python3 - "$OPENCODE_BIN" "$FORMULA_PREFIX" <<'PY'
import os
import sys
print(os.path.realpath(sys.argv[1]))
print(os.path.realpath(sys.argv[2]) if sys.argv[2] else "")
PY
)"
    RESOLVED_OPENCODE="${RESOLVED_PATHS%%$'\n'*}"
    RESOLVED_FORMULA_PREFIX="${RESOLVED_PATHS#*$'\n'}"
    if [ -n "$RESOLVED_FORMULA_PREFIX" ]; then
      case "$RESOLVED_OPENCODE" in
        "$RESOLVED_FORMULA_PREFIX"/*)
          echo "-> Updating OpenCode..."
          brew upgrade opencode
          ;;
        *)
          echo "!! opencode is installed outside Homebrew; skipping automatic update."
          ;;
      esac
    else
      echo "!! opencode is installed outside Homebrew; skipping automatic update."
    fi
  else
    echo "!! opencode is installed outside Homebrew; skipping automatic update."
  fi
else
  echo "!! opencode not found. Install it with: brew install opencode"
fi

BACKUP=""
HAD_CONFIG=0
if [ -d "$OC" ]; then
  HAD_CONFIG=1
  BACKUP_BASE="$HOME/.config/opencode.backup.$(date +%Y%m%d-%H%M%S)"
  BACKUP="$BACKUP_BASE"
  BACKUP_SUFFIX=0
  while ! mkdir "$BACKUP" 2>/dev/null; do
    if [ ! -e "$BACKUP" ]; then
      echo "ERROR: could not reserve backup path: $BACKUP" >&2
      exit 1
    fi
    BACKUP_SUFFIX=$((BACKUP_SUFFIX + 1))
    BACKUP="$BACKUP_BASE.$BACKUP_SUFFIX"
  done
  echo "-> Backing up existing config to $BACKUP..."
  rsync -a --exclude node_modules "$OC/" "$BACKUP/"
fi

rollback_deployment() {
  if [ "$HAD_CONFIG" = 1 ]; then
    rsync -a --delete --exclude node_modules "$BACKUP/" "$OC/"
  else
    rm -rf "$OC"
  fi
}

mkdir -p "$OC"
echo "-> Installing orchestrator config..."
if ! rsync -a --delete "${DEPLOY_EXCLUDES[@]}" "$STAGE/" "$OC/"; then
  echo "Configuration deployment copy FAILED; rolling back."
  rollback_deployment
  exit 1
fi

echo "Validating native compaction and Engram integration..."
validation_fail=0
node -e 'const config = require(process.argv[1]); if (config.compaction?.auto !== true || config.compaction?.prune !== false) process.exit(1)' "$OC/opencode.json" \
  && echo "OK: native automatic compaction enabled with pruning disabled" \
  || { echo "FAIL: native compaction configuration missing"; validation_fail=1; }
node "$PLUGIN_VALIDATOR" "$OC/plugins/engram.ts" \
  && echo "OK: Engram compaction recovery configured" \
  || { echo "FAIL: Engram compaction recovery missing"; validation_fail=1; }
node "$PROMPT_VALIDATOR" "$OC" \
  && echo "OK: deployed agent prompts configured" \
  || { echo "FAIL: deployed agent prompt configuration invalid"; validation_fail=1; }
if [ -n "$POST_DEPLOY_VALIDATOR" ]; then
  node "$POST_DEPLOY_VALIDATOR" "$OC" \
    || { echo "FAIL: post-deployment validation failed"; validation_fail=1; }
fi
if [ "$validation_fail" != 0 ]; then
  echo "Deployed configuration validation FAILED; restoring previous config."
  rollback_deployment
  exit 1
fi

echo
echo "OK bootstrap complete."
echo "   Restart OpenCode so it reloads the installed config, prompts, plugins, and Engram binary."
echo "   Then open OpenCode and authenticate with your model providers."
echo "   Credentials and personal memory are intentionally not deployed."
